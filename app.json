{
  "expo": {
    "name": "Parla",
    "slug": "parla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parla",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161826",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parla.app"
    },
    "android": {
      "package": "com.parla.app",
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161826",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Parla utilise le micro pour que votre agent puisse vous écouter.",
          "speechRecognitionPermission": "Parla transcrit votre voix pour converser avec votre agent."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
